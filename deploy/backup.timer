# Раз в сутки ночью, когда матчей нет. Persistent=true: сервер был выключен в этот час —
# бэкап сделается при первом включении, а не пропустится.
[Unit]
Description=RHL U21 state backup once a day

[Timer]
OnCalendar=*-*-* 04:17:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
