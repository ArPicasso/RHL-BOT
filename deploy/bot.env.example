# Шаблон /etc/rhl/bot.env — переменные служб bot, live, api и pages. Права 640, владелец root:rhl. Не в git.

# Токен бота от @BotFather. Им же сервер API проверяет подпись initData мини-аппа
BOT_TOKEN=

# Мини-апп на GitHub Pages: бот берёт оттуда данные, API сверяет расклады «Раската» и читает league.json
WEBAPP_URL=https://arpicasso.github.io/RHL-BOT/

# Соль раскладов «Раската» — то же значение, что в секрете RASKAT_SALT задания Pages. Пусто — соль из
# raskat/rules.py. Не совпали с Pages — зачёт выключается сам, причина в /api/health
RASKAT_SALT=

# Адрес зачёта для бота (лист ожидания, ADR-018). Дописывает deploy/https.sh
# RASKAT_API=https://<хост>/api/raskat

# Откуда мини-апп ходит в API: CORS только для этого адреса (несколько — через запятую)
PAGES_ORIGIN=https://arpicasso.github.io

# Каталог живых файлов матч-центра: пишет live.py, отдаёт server.py, читает бот. Не задан — live/
# рядом с кодом, то есть /opt/rhl/live; другой путь должен лежать внутри /opt/rhl (ReadWritePaths служб)
# LIVE_DIR=/opt/rhl/live

# База зачёта и прогнозов (SQLite). По умолчанию /opt/rhl/state.db
# STATE_DB=/opt/rhl/state.db

# Где слушает API. Наружу его выводит только Caddy (deploy/https.sh)
# API_HOST=127.0.0.1
# API_PORT=8080

# Служба pages (pages_kick.py, ADR-015): раз в 15 минут запускает сборку мини-аппа, чтобы посты каналов
# доходили до ленты быстро — cron GitHub теряет запуски. Токен: github.com → Settings → Developer settings →
# Fine-grained tokens, репозиторий только ArPicasso/RHL-BOT, право Repository permissions → Actions:
# Read and write, больше ничего. Пусто — служба ничего не шлёт. После правки: systemctl restart pages
PAGES_TOKEN=

# Пульт админа (ADR-021): Telegram id админов через запятую. Бот на /admin пришлёт им кнопку пульта,
# API отдаст данные только им. Свой id — напиши боту /admin. После правки: systemctl restart bot api
ADMIN_IDS=

# Куда бот и служба pages пишут счётчики для пульта. По умолчанию /opt/rhl/status (создаёт rhl-update)
# STATUS_DIR=/opt/rhl/status
