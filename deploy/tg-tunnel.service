# SOCKS-туннель до Telegram через зарубежный сервер: с VPS в России api.telegram.org закрыт.
# Бот ходит через него по TELEGRAM_PROXY=socks5://127.0.0.1:1080. Установка — deploy/tunnel.sh.
[Unit]
Description=SOCKS tunnel to Telegram via foreign host
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/rhl/tunnel.env
ExecStart=/usr/bin/ssh -N -D 127.0.0.1:1080 -i /root/.ssh/rhl_tunnel \
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
  -o BatchMode=yes -o StrictHostKeyChecking=yes -p ${TUNNEL_PORT} ${TUNNEL_HOST}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
