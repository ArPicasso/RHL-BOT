# Шаблон /etc/rhl/zveno.env — переменные сервера «Звена». Настоящий файл живёт только на сервере,
# права 640, владелец root:rhl. Токен в git не коммитить никогда (правило 2 CLAUDE.md).

# Токен бота от @BotFather — тот же, что у bot.py: им проверяется initData и отправляются сообщения
BOT_TOKEN=

# База SQLite (каталог /var/lib/rhl создаёт systemd)
ZVENO_DB=/var/lib/rhl/zveno.db

# Опубликованные данные «Звена»: tours.json, pool.json, matches.json (URL каталога или путь)
ZVENO_DATA_URL=https://arpicasso.github.io/bogdanov/data/zveno/

# Адрес мини-аппа на GitHub Pages — только ему браузер разрешит ходить в API (CORS). Без пути и слеша
ZVENO_ORIGIN=https://arpicasso.github.io

# Локальный порт, наружу его открывает только nginx
ZVENO_PORT=8090

# Мини-апп — для кнопки «Открыть «Звено»» в сообщениях
WEBAPP_URL=https://arpicasso.github.io/bogdanov/

# 0 — не отправлять сообщения (например, на тестовом сервере)
ZVENO_MESSAGES=1
